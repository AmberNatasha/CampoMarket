<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UseAppHost>false</UseAppHost>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>CampoMarket-Web-2026</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="EmailTemplates\Contacto.html" />
    <None Remove="EmailTemplates\RecuperarContrasena.html" />
    <None Remove="EmailTemplates\Contacto.txt" />
    <None Remove="EmailTemplates\RecuperarContrasena.txt" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="EmailTemplates\Contacto.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="EmailTemplates\RecuperarContrasena.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="EmailTemplates\Contacto.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="EmailTemplates\RecuperarContrasena.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.17.0" />
  </ItemGroup>

</Project>
